# Read automatically by `docker compose` (it loads a .env file from the
# same directory as docker-compose.yml) to fill in the ${VAR} references in
# docker-compose.yml. Copy this to a real `.env` here for a docker-compose
# deployment. This is DIFFERENT from backend/.env.example (used when
# running the backend directly with uvicorn, no Docker) and
# frontend/.env.example (a Vite build-time variable) -- all three exist
# because they're read by three different tools at three different times.
ENVIRONMENT=development
SECRET_KEY=
DATABASE_URL=sqlite:////app/data/securemailscope.db
CORS_ORIGINS=
MAX_UPLOAD_SIZE_MB=250
MAX_PACKETS_PER_CAPTURE=500000

# Only read when running `docker compose --profile production up`
# (the bundled Postgres service) -- see docker-compose.yml.
POSTGRES_DB=securemailscope
POSTGRES_USER=securemailscope
POSTGRES_PASSWORD=
