# ENVIRONMENT=development leaves things convenient for local/free-tier runs:
# SECRET_KEY auto-generates ephemerally if unset, and CORS defaults to "*".
# Set ENVIRONMENT=production to turn on hard enforcement below -- the app
# refuses to start without a real SECRET_KEY and an explicit CORS_ORIGINS.
ENVIRONMENT=development

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# REQUIRED (min 32 chars) when ENVIRONMENT=production.
SECRET_KEY=

# SQLite is fine for a single-instance free-tier deployment. Point this at
# PostgreSQL before running more than one backend worker/instance:
# DATABASE_URL=postgresql://securemailscope:PASSWORD@postgres:5432/securemailscope
DATABASE_URL=sqlite:///./securemailscope.db

UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=250
MAX_PACKETS_PER_CAPTURE=500000

# Comma-separated list of allowed frontend origins. REQUIRED when
# ENVIRONMENT=production, e.g.:
# CORS_ORIGINS=https://securemailscope.ntro.gov.in
CORS_ORIGINS=

# Only used when running `docker compose --profile production up` with the
# bundled postgres service.
# POSTGRES_DB=securemailscope
# POSTGRES_USER=securemailscope
# POSTGRES_PASSWORD=
