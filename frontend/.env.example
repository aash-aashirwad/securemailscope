# Leave unset for local dev (Vite's dev-server proxy handles /api) and for
# the docker-compose deployment (nginx reverse-proxies /api to the backend
# container) -- both work fine with the default same-origin '/api'.
#
# Set this ONLY when frontend and backend are deployed as separate origins
# -- which is Render's normal setup (a Static Site + a separate Web
# Service, each on its own *.onrender.com domain). Point it at the deployed
# backend's own URL, including the /api suffix:
# VITE_API_BASE_URL=https://securemailscope-backend.onrender.com/api
VITE_API_BASE_URL=
